# ---------------------------------------------------------------------------
# ShiftShare environment variables
# Copy this file to `.env.local` and fill in the values.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project Settings → API in the Supabase dashboard.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so
# after changing them you must restart the dev server (or rebuild) — editing
# them while the server runs has no effect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses row-level security — never expose it to the browser
# and never prefix it with NEXT_PUBLIC_. Only used by scripts and admin tasks;
# the app itself does not need it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (for /events/new) --------------------------------------------
# Server-only. Used by POST /api/plan to turn one sentence into a staffing plan.
# Never prefix this with NEXT_PUBLIC_ — it must not reach the browser.
# Get a key at console.anthropic.com → API keys.
# Without it, /events/new falls back to a built-in demo planner and says so.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Pinned model IDs are the right choice in production; this default
# will age. Any current Claude model ID works.
ANTHROPIC_MODEL=claude-sonnet-5

# --- App --------------------------------------------------------------------
# Used to build auth redirect URLs (email confirmation, password reset, OAuth).
# Must match a URL in Supabase → Authentication → URL Configuration.
# Leave as-is for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google sign-in setup (one-time, in the Supabase dashboard)
#
#   1. Google Cloud Console → APIs & Services → Credentials
#      → Create OAuth client ID → Web application
#      Authorized redirect URI:
#        https://<your-project-ref>.supabase.co/auth/v1/callback
#   2. Supabase → Authentication → Providers → Google
#      Paste the Client ID and Client Secret, enable the provider.
#   3. Supabase → Authentication → URL Configuration
#      Site URL:            http://localhost:3000
#      Redirect URLs:       http://localhost:3000/auth/callback
#                           https://your-domain.com/auth/callback
#
# Email/password sign-in works without any of this.
# ---------------------------------------------------------------------------
