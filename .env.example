# Supabase — get these from Project Settings → API in the Supabase dashboard:
# https://supabase.com/dashboard/project/ynuvsphkmdamduvgnzgp/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://ynuvsphkmdamduvgnzgp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used to build absolute redirect URLs during auth flows and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic — used by the server-side shift planner at /api/plan.
# Leave unset to run the planner against the built-in demo generator.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Resend — server-only transactional email notifications (lib/email.ts).
# Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
EMAIL_FROM="ShiftShare <onboarding@resend.dev>"

# Cron secret — required as Authorization: Bearer <CRON_SECRET> on /api/cron/reminders.
CRON_SECRET=
